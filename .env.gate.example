# prove-it-ai-gate environment configuration
# Copy this file to .env.gate and fill in values

# Path to evidence folder root (default: ./evidence)
AI_GATE_EVIDENCE_ROOT=./evidence

# Path to policy packs directory (default: ./policies)
AI_GATE_POLICY_DIR=./policies

# Default policy pack (used when --policy is omitted)
AI_GATE_DEFAULT_POLICY=read_only_audit

# Log level: DEBUG, INFO, WARNING, ERROR
AI_GATE_LOG_LEVEL=INFO

# Evidence retention: days to keep accepted evidence (0 = keep all)
AI_GATE_RETENTION_DAYS=30

# Scratch directory for temporary agent files (outside target repos)
AI_GATE_SCRATCH_DIR=./scratch
